# ---------------------------------------------------------------- veritabanı
# Lokalde hiçbir şey yapmana gerek yok: data/store.db dosyası otomatik oluşur.
# Netlify'a çıkarken Turso (ücretsiz) bilgilerini gir:
# TURSO_DATABASE_URL="libsql://veritabanin-kullaniciadin.turso.io"
# TURSO_AUTH_TOKEN="..."

# ------------------------------------------------------------------ yönetici
# İlk çalıştırmada bu bilgilerle admin hesabı oluşturulur (varsayılan: admin@enteknoloji.com / admin123)
ADMIN_EMAIL="admin@enteknoloji.com"
ADMIN_PASSWORD="admin123"

# Oturum çerezini imzalar. Canlıda mutlaka rastgele uzun bir değerle değiştir.
AUTH_SECRET="lutfen-bunu-uzun-ve-rastgele-bir-degerle-degistir"

# -------------------------------------------------------------------- iyzico
# Boş bırakılırsa siparişler "havale/EFT" olarak kaydedilir, site yine çalışır.
# IYZICO_API_KEY="sandbox-..."
# IYZICO_SECRET_KEY="sandbox-..."
# Test: https://sandbox-api.iyzipay.com  |  Canlı: https://api.iyzipay.com
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# --------------------------------------------------------------------- genel
# Netlify'da kendi domainini yaz; iyzico callback adresi buradan üretilir.
# NEXT_PUBLIC_SITE_URL="https://siteniz.netlify.app"
